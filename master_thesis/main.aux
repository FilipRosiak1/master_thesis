\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Distributions of retained final \ensuremath  {\mathit  {vertpos}}{} for the fifteen fixed LSO configurations, grouped by optimizer. Each box summarizes 150 runs; the centre line is the median, the box spans the interquartile range, and whiskers reach the most extreme observations within 1.5 interquartile ranges of the quartiles. Points beyond the whiskers remain visible.}}{39}{figure.5.4}\protected@file@percent }
\newlabel{fig:lso-final-score-distributions}{{5.4}{39}{Distributions of retained final \vertpos {} for the fifteen fixed LSO configurations, grouped by optimizer. Each box summarizes 150 runs; the centre line is the median, the box spans the interquartile range, and whiskers reach the most extreme observations within 1.5 interquartile ranges of the quartiles. Points beyond the whiskers remain visible}{figure.5.4}{}}
