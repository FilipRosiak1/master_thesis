\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces Cross-configuration aggregate retained final scores for TreeVAE-80 with latent EA, TransformerVAE-90 with latent EA, and the mini Framsticks EA baseline. Each point is the mean over the same 150 source records, and each error bar shows one full sample standard deviation. LSO used \texttt  {eval-allcriteria.sim} only, whereas mini EA used the four-file chain beginning with \texttt  {eval-allcriteria-mini.sim}; the values are descriptive rather than controlled method effects.}}{41}{figure.5.6}\protected@file@percent }
\newlabel{fig:lso-mini-aggregate}{{5.6}{41}{Cross-configuration aggregate retained final scores for TreeVAE-80 with latent EA, TransformerVAE-90 with latent EA, and the mini Framsticks EA baseline. Each point is the mean over the same 150 source records, and each error bar shows one full sample standard deviation. LSO used \texttt {eval-allcriteria.sim} only, whereas mini EA used the four-file chain beginning with \texttt {eval-allcriteria-mini.sim}; the values are descriptive rather than controlled method effects}{figure.5.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces Cross-configuration source-aligned view of the two fixed leading latent-EA configurations and the mini Framsticks EA baseline. The upper panels show retained final scores for the same 150 source records against the equality line, and the lower panels show aligned LSO-minus-mini score distributions against zero. LSO used \texttt  {eval-allcriteria.sim} only, whereas mini EA used the four-file chain beginning with \texttt  {eval-allcriteria-mini.sim}; these differences are descriptive rather than controlled paired effects.}}{42}{figure.5.7}\protected@file@percent }
\newlabel{fig:lso-mini-aligned}{{5.7}{42}{Cross-configuration source-aligned view of the two fixed leading latent-EA configurations and the mini Framsticks EA baseline. The upper panels show retained final scores for the same 150 source records against the equality line, and the lower panels show aligned LSO-minus-mini score distributions against zero. LSO used \texttt {eval-allcriteria.sim} only, whereas mini EA used the four-file chain beginning with \texttt {eval-allcriteria-mini.sim}; these differences are descriptive rather than controlled paired effects}{figure.5.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.8}{\ignorespaces Cross-configuration best-so-far trajectories for TreeVAE-80 with latent EA, TransformerVAE-90 with latent EA, and mini Framsticks EA. Each panel shows the median retained score and interquartile range over 150 source records. LSO used \texttt  {eval-allcriteria.sim} only, whereas mini EA used the four-file chain beginning with \texttt  {eval-allcriteria-mini.sim}; the trajectories are descriptive and the horizontal axis reports requested candidate slots rather than unique simulator evaluations.}}{43}{figure.5.8}\protected@file@percent }
